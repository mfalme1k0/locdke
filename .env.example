# Postgres connection string
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/locdke

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Server-side rate limiting for public bookings (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- File storage (REQUIRED in production) ---
# Netlify/Vercel disks are wiped on every deploy, so uploads must live in a bucket.
# Any S3-compatible service works (Cloudflare R2 recommended: free tier, no egress fees).
# Leave S3_BUCKET empty in local dev to store files on disk instead.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
